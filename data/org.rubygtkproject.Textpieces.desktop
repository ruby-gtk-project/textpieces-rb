#
# Ported from upstream's data/com.github.liferooter.textpieces.desktop.in.
# Exec points at this port's launcher (exe/textpieces, installed as
# `textpieces` on PATH) rather than upstream's compiled binary; Icon and the
# application id match this port's id, org.rubygtkproject.Textpieces, used
# throughout lib/ (see Textpieces::Application::APP_ID). Everything else —
# MimeType, Categories, Keywords and the New Window launcher action — is
# upstream's, unchanged.

[Desktop Entry]
Name=Text Pieces
Icon=org.rubygtkproject.Textpieces
Exec=textpieces %U
MimeType=text/plain;
Terminal=false
Type=Application
Categories=Utility;TextTools;GTK;GNOME;
StartupNotify=true
Actions=new-window;

# Translators: Search terms to find this application. Do NOT translate or localize the semicolons! The list MUST also end with a semicolon!
Keywords=GNOME;GTK;Text;Base64;JSON;YAML;Count;SHA1;SHA256;SHA384;SHA512;MD5;Checksum;Escape;Encode;HTML;URL;Prettify;Filter;Reverse;Trim;

[Desktop Action new-window]
Name=New Window
Exec=textpieces
